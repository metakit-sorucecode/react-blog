   const deleteBoard = useMutation({
     mutationFn: () => http.delete(`/api/boards/${id}`),
     onSuccess: async () => {
+      // 목록 키를 무효화한다
+      // 목록을 쓰는 화면이 없어 inactive라 "all"로 지금 받게 한다
+      // 다 받은 뒤 이동한다. 그래야 홈에 지운 글이 잠깐도 보이지 않는다
       await queryClient.invalidateQueries({
